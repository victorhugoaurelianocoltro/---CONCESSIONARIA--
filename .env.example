# Public WhatsApp number with country code, digits only. Replace this with the real dealership number.
NEXT_PUBLIC_DEALERSHIP_WHATSAPP=

# Optional public canonical site URL (example: https://www.your-dealership.com.br).
NEXT_PUBLIC_SITE_URL=

# Private administrator credentials. Set a unique password and random secret.
DEALERSHIP_ADMIN_USERNAME=
DEALERSHIP_ADMIN_PASSWORD=
DEALERSHIP_ADMIN_SESSION_SECRET=

# SQLite database path. Use a persistent local volume on a single Node.js server.
DEALERSHIP_DB_PATH=